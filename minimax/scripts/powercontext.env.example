# PowerContext Server 配置示例（占位值）
#
# scripts/setup.sh 会按探测到的运行期目录生成真正的 scripts/powercontext.env，
# 那个文件含本机绝对路径，不进版本库；本文件只作示例，方便评审了解可配置项。
#
# 关键配置项来自 powercontext 1.2.0 的 .env.example：
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
# 嵌入式 seekdb 的数据目录必须在支持 O_DIRECT 的本地文件系统上（NFS 会报
# seekdb_open failed: code=-1），setup.sh 会自动探测一个可用目录。
POWERCONTEXT_SERVER_DATABASE_PATH=/var/tmp/sddctx-runtime/powercontext-seekdb
POWERCONTEXT_SERVER_WORKSPACE=/var/tmp/sddctx-runtime/powercontext-workspace
