{
  "name": "stepfun-seekdb-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "阶跃星辰 × OceanBase seekdb 赛题:浏览器端侧 embedding + seekdb 混合检索迷你知识库",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/copy_ort.mjs && node scripts/fetch_model.mjs",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/src/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/src/index.mjs",
    "bench": "node scripts/bench.mjs",
    "eval": "node scripts/eval_quality.mjs",
    "model:fetch": "node scripts/fetch_model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "vite": "^6.3.5"
  }
}
